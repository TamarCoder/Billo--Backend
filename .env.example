PORT=4000
# Comma separated frontend origins for local development.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,app://-
POSTGRES_DB=billo_dev
POSTGRES_USER=billo_dev
POSTGRES_PASSWORD=replace_with_a_local_password
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=billo_dev
DB_PASSWORD=replace_with_a_local_password
DB_DATABASE=billo_dev
# true on Render/Neon, false for local Docker Postgres
DB_SSL=false
# Number of proxies in front of the API (Render: 1). Leave empty locally.
TRUST_PROXY=
# Used once by `npm run seed:organization` to create the first organization. Clear after seeding.
SEED_ORG_IDENTIFICATION_CODE=
SEED_ORG_EMAIL=
SEED_ORG_PASSWORD=
# Used once by `npm run admin:promote` to make an existing organization an admin.
ADMIN_IDENTIFICATION_CODE=
