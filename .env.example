PORT=4000
# Comma separated frontend origins for local development.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,app://-
POSTGRES_DB=billo_dev
POSTGRES_USER=billo_dev
POSTGRES_PASSWORD=replace_with_a_local_password
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=billo_dev
DB_PASSWORD=replace_with_a_local_password
DB_DATABASE=billo_dev
# true on Render/Neon, false for local Docker Postgres
DB_SSL=false
